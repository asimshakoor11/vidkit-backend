APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated frontend origins (no trailing slash). Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# SQLite for local dev. For Postgres paste the provider URL as-is; postgres:// and
# postgresql:// are rewritten to the psycopg driver automatically.
#   Neon:     postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/vidkit?sslmode=require
#   Supabase: postgresql://postgres.ref:pass@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./vidkit.db

# Uploads/outputs (temporary, deleted after FILE_TTL_MINUTES)
STORAGE_DIR=./storage

# System binaries (the Docker image puts all of these on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GS_PATH=gs
LIBREOFFICE_PATH=soffice
TESSERACT_PATH=tesseract
POPPLER_PATH=
PANDOC_PATH=pandoc

# Optional Netscape cookies file for login-only Instagram/Facebook/YouTube content
YTDLP_COOKIES_FILE=

# Limits
MAX_UPLOAD_MB=4096
MAX_VIDEO_DURATION_MIN=180
MAX_CONCURRENT_JOBS=2
FILE_TTL_MINUTES=60
RATE_LIMIT_INFO=10/minute
RATE_LIMIT_JOBS=5/hour
PDF_CONVERT_TIMEOUT_SEC=300
AUDIO_SEPARATE_TIMEOUT_SEC=900
MARKDOWN_TIMEOUT_SEC=120

# Public URL of this API; short links are PUBLIC_BASE_URL/r/{code}
PUBLIC_BASE_URL=http://localhost:8000
SHORT_URL_TTL_DAYS=30
